# Copie para server/.env (este arquivo de exemplo vai para o git; o .env não).

# Endereço público do ZimaOS no Tailscale (sem https://)
PUBLIC_HOST=servidor.tail39f8dc.ts.net

# Endereços do app que podem usar a API (separados por vírgula; * vale para um trecho do nome)
ALLOWED_ORIGINS=https://huddle-hugo-project.vercel.app,https://huddle-*-hugo-project.vercel.app

# Gere cada um com: openssl rand -hex 32
SESSION_SECRET=
LIVEKIT_API_KEY=huddle
LIVEKIT_API_SECRET=

# Tamanho máximo de uma gravação, em MB
MAX_UPLOAD_MB=4096

# Administradores da plataforma (entram em qualquer time). Separados por vírgula.
SUPERADMIN_EMAILS=
